---
// <Section title="…" lead="…">…</Section> — a titled block of prose inside a guide .mdx.
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section>
  <div class="section-head">
    <h2>{title}</h2>
    {lead && <p>{lead}</p>}
  </div>
  <slot />
</section>
