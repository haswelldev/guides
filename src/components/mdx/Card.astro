---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="card">
  <h3>{title}</h3>
  <slot />
</div>

<style>
  .card { background: var(--panel); padding: 16px 18px; display: flex; flex-direction: column; gap: 5px; }
  h3 { font-size: 1rem; }
  .card :global(p) { font-size: 0.88rem; }
</style>
