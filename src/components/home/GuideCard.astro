---
import type { Guide } from '../../lib/guides';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { title, quest, blurb } = guide.data;
---

<article class="card" data-chronicles={guide.chronicles.join(' ')}>
  <h3><a href={guide.url}>{title}</a></h3>
  {quest && <span class="label">Quest {quest.id} · {quest.name}</span>}
  <p>{blurb}</p>
  <ul class="badges" aria-label="Chronicle versions">
    {
      guide.variants.map((v) => (
        <li>
          <a class="badge" href={v.url} data-chronicles={v.chronicles.join(' ')}>
            {v.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="missing" hidden></p>
</article>

<style>
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 3px solid var(--bronze);
    border-radius: var(--radius);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: opacity 0.2s ease;
  }
  .card.is-off { opacity: 0.55; border-top-color: var(--line-strong); }
  h3 { font-size: 1.35rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ' \2192'; color: var(--bronze); }
  h3 a:hover { color: var(--bronze); }
  p { font-size: 0.92rem; }
  .badges { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 2px 8px;
  }
  .badge:hover { border-color: var(--bronze); color: var(--bronze); }
  .badge.is-match { background: var(--bronze); border-color: var(--bronze); color: var(--panel); }
  .missing { font-size: 0.82rem; color: var(--ink-faint); font-style: italic; }
</style>
